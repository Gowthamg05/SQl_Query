/*
Q7. Find product categories where the total sales is greater than 100.

Use:

sales.orders
sales.products */

select * from sales.employees

select * from sales.orders

select p.category,
o.sales
from sales.products as p 
left join sales.orders as o on o.productid=p.productid
group by p.category 
having sum(o.sales)>100

SELECT 
    p.category,
    SUM(o.sales) AS total_sales
FROM sales.products p
LEFT JOIN sales.orders o
    ON p.productid = o.productid
GROUP BY p.category
HAVING SUM(o.sales) > 100;

/* Level 3 — JOIN + GROUP BY + HAVING

Q8. Find each product category and the total quantity sold.
Display only categories where total quantity is greater than 3. */

select * from sales.orders


select 
p.category,
sum(o.quantity) as tot_quantity
from sales.products p
left join
sales.orders o on p.productid=o.productid
group by p.category 
having sum(o.quantity)>3

/*
Q9. Find each salesperson's total sales.
Display only salespersons whose total sales are greater than 50.
*/

select * from sales.orders

select 
salespersonid,
sum(sales) as tot_sales
from sales.orders
group by salespersonid
having sum(sales) >50











